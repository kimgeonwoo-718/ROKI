    <!-- Download errors -->
    <string name="download_error_no_source">이 모델은 앱에서 내려받을 수 없어요.</string>
    <string name="download_error_space">저장공간이 부족해요. %1$s가 필요한데 %2$s만 남아 있어요. 공간을 비운 뒤 다시 시도해 주세요.</string>
